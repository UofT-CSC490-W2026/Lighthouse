# Copy to .env.deploy and fill in real values before running:
#   cp .env.deploy.example .env.deploy
#   $EDITOR .env.deploy
#   TAG=$(git rev-parse --short HEAD) AUTO_APPROVE=1 ./scripts/deploy_aws_stack.sh

# Required secrets
DB_PASSWORD=replace-me
GITHUB_OAUTH_CLIENT_ID=replace-me
GITHUB_OAUTH_CLIENT_SECRET=replace-me

# Required when using the default OpenAI embedding/LLM strategies
OPENAI_API_KEY=replace-me

# Required for Temporal Cloud
TEMPORAL_ADDRESS=your-namespace.tmprl.cloud:7233
TEMPORAL_NAMESPACE=your-namespace.account-id
TEMPORAL_API_KEY=replace-me

# Common deployment settings
REGION=us-east-1
TAG=latest
AUTO_APPROVE=0

# Optional overrides
# ACCOUNT_ID=123456789012
# PROJECT_NAME=lighthouse
# ENVIRONMENT=prod
# PRIVATE_DNS_NAMESPACE_NAME=lighthouse-prod.local
# MCP_SSM_NAME=/lighthouse/prod/mcp-server
# SEARCH_SSM_NAME=/lighthouse/prod/search
# INGESTION_SSM_NAME=/lighthouse/prod/ingestion
# WEB_REPO=lighthouse-prod-web
# MCP_REPO=lighthouse-prod-mcp
# SEARCH_REPO=lighthouse-prod-search
# INGEST_REPO=lighthouse-prod-ingestion
# KMS_KEY_ID=alias/aws/ssm
# INTERNAL_SERVICE_TOKEN=replace-me
# SESSION_ENCRYPTION_KEY=replace-me
# GITHUB_WEBHOOK_SECRET=replace-me

# Shared strategy defaults. Service-specific overrides below win if set.
# EMBEDDING_STRATEGY=openai
# LLM_STRATEGY=openai

# Search service overrides
# SEARCH_EMBEDDING_STRATEGY=openai
# SEARCH_EMBEDDING_MODEL=text-embedding-3-large
# SEARCH_RERANK_MODEL=rerank-v4.0-pro
# SEARCH_LLM_MODEL=gpt-5.4-nano
# SEARCH_LLM_REASONING_EFFORT=none

# Ingestion service overrides
# INGESTION_EMBEDDING_STRATEGY=openai
# INGESTION_EMBEDDING_MODEL=text-embedding-3-large
# INGESTION_EMBEDDING_DIMENSION=3072
# INGESTION_LLM_STRATEGY=openai
# INGESTION_LLM_MODEL=gpt-5.4-mini
# INGESTION_LLM_REASONING_EFFORT=low
# INGESTION_CLONE_BASE_DIR=/tmp/lighthouse_repos
# TEMPORAL_TASK_QUEUE=ingestion
# CHUNKER_STRATEGY=ast_code

# Provider and MCP-specific overrides
# COHERE_API_KEY=
# MCP_DEBUG=false
# SESSION_TTL_HOURS=168
