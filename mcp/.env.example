SERVICE_NAME=Lighthouse MCP Context Service
APP_ENV=local
DEBUG=true
CORS_ALLOW_ORIGINS=http://localhost:6274,http://127.0.0.1:6274

# Config provider:
# - auto: use .env in local/dev/test, Parameter Store elsewhere
# - env: always use environment/.env only
# - ssm: always try Parameter Store
LIGHTHOUSE_CONFIG_PROVIDER=auto

# Optional Parameter Store path templates.
# LIGHTHOUSE_PARAMETER_PREFIX=/lighthouse/{app_env}/{service}
# LIGHTHOUSE_PARAMETER_PREFIX_MCP=/lighthouse/{app_env}/mcp

# Postgres connection DSN (runtime index metadata + code graph).
# Example:
# POSTGRES_DSN=postgresql://postgres:postgres@localhost:5432/lighthouse
POSTGRES_DSN=

# Milvus vector store settings.
MILVUS_URI=http://localhost:19530
MILVUS_USER=
MILVUS_PASSWORD=
MILVUS_DATABASE=default

# Temporal orchestration settings.
TEMPORAL_TARGET_HOST=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE_RUNTIME=runtime-indexing
TEMPORAL_TASK_QUEUE_OFFLINE=offline-datasets
TEMPORAL_TASK_QUEUE_MENTAL_MODEL=mental-model

# GitHub token for private target repo reads (read-only scope).
GITHUB_READ_TOKEN=

AWS_REGION=us-east-1
