service_name=Lighthouse MCP Context Service
app_env=local
debug=true
cors_allow_origins=http://localhost:6274,http://127.0.0.1:6274

# Postgres connection DSN (runtime index metadata + code graph).
# Example:
# postgres_dsn=postgresql://postgres:postgres@localhost:5432/lighthouse
postgres_dsn=

# Milvus vector store settings.
milvus_uri=http://localhost:19530
milvus_user=
milvus_password=
milvus_database=default

# Temporal orchestration settings.
temporal_target_host=localhost:7233
temporal_namespace=default
temporal_runtime_task_queue=runtime-indexing
temporal_offline_task_queue=offline-datasets
temporal_mental_model_task_queue=mental-model

# GitHub token for private target repo reads (read-only scope).
github_read_token=
