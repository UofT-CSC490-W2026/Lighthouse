POSTGRES_DSN=postgresql://lighthouse:lighthouse@localhost:5432/lighthouse
MILVUS_URI=http://localhost:19530
TEMPORAL_ADDRESS=localhost:7233

LLM_STRATEGY=openai
OPENAI_API_KEY=
EMBEDDING_STRATEGY=openai
EMBEDDING_DIMENSION=3072
EMBEDDING_MODEL=text-embedding-3-large
OPENAI_REASONING_EFFORT=none
LLM_MODEL=gpt-5.4-nano

CHUNKER_STRATEGY=ast_code

# Run `uv run python -c "import secrets; print(secrets.token_hex(32))"` to generate a random secret.
GITHUB_WEBHOOK_SECRET=

# Shared secret for internal service-to-service auth. Leave empty to disable (local dev).
INTERNAL_SERVICE_TOKEN=
