DEBUG=true

# If you are running the web app in Docker, change 5173 to 3000.
CORS_ALLOW_ORIGINS=["http://localhost:5173"]

POSTGRES_DSN=
MCP_SERVER_SETTINGS_SSM_PARAMETER=
AWS_REGION=
SEARCH_SERVICE_URL=http://localhost:8002
INGESTION_SERVICE_URL=http://localhost:8001

# GitHub OAuth (register at https://github.com/settings/developers)
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=http://localhost:8000/v1/auth/github/callback

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SESSION_ENCRYPTION_KEY=

# If you are running the web app in Docker, change 5173 to 3000.
WEB_CLIENT_URL=http://localhost:5173
SESSION_TTL_HOURS=168

# If you are running in Docker, use service hostnames instead:
# SEARCH_SERVICE_URL=http://search:8002
# INGESTION_SERVICE_URL=http://ingestion:8001
